{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"jsx": "preserve",
		"lib": ["DOM", "DOM.Iterable", "ES2022"],
		"types": ["node"],
		"noEmit": true,
		"allowJs": true,
		"plugins": [
			{
				"name": "next"
			}
		],
		"paths": {
			"@essai/core": ["../core/src/index.ts"]
		},
		"incremental": true
	},
	"include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
	"exclude": ["node_modules"]
}
