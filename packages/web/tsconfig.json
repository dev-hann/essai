{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"lib": ["DOM", "DOM.Iterable", "ES2022"],
		"jsx": "preserve",
		"noEmit": true,
		"allowJs": false,
		"plugins": [{ "name": "next" }],
		"incremental": true,
		"resolveJsonModule": true,
		"moduleResolution": "Bundler",
		"paths": {
			"@/*": ["./src/*"]
		}
	},
	"include": [
		"next-env.d.ts",
		"**/*.ts",
		"**/*.tsx",
		".next/types/**/*.ts"
	],
	"exclude": ["node_modules", ".next", "dist"]
}
