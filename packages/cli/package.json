{
	"name": "essai",
	"version": "0.1.0",
	"type": "module",
	"main": "./dist/index.js",
	"bin": {
		"essai": "./dist/index.js"
	},
	"description": "AI writing tool where the author holds the pencil — write fiction and novels with structured AI assistance.",
	"keywords": [
		"ai",
		"fiction",
		"writing",
		"novel",
		"cli"
	],
	"license": "MIT",
	"author": "Hann (dev-hann)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dev-hann/essai.git",
		"directory": "packages/cli"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "vitest run --passWithNoTests"
	},
	"dependencies": {
		"@ai-sdk/openai-compatible": "^3.0.12",
		"@essai/core": "workspace:*",
		"@essai/web": "workspace:*",
		"ai": "^7.0.31",
		"commander": "^14.0.0",
		"next": "^15.1.6",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/json-schema": "^7.0.15",
		"@types/node": "^26.1.1",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	}
}
