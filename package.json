{
	"name": "essai-monorepo",
	"private": true,
	"version": "0.0.0",
	"description": "AI writing tool where the author holds the pencil. Monorepo for the essai CLI, core library, and web UI.",
	"packageManager": "pnpm@9.15.9",
	"scripts": {
		"build": "turbo run build",
		"test": "turbo run test",
		"lint": "biome check .",
		"format": "biome format --write .",
		"changeset": "changeset",
		"version": "changeset version",
		"release": "pnpm build && changeset publish"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.4",
		"@changesets/cli": "^2.29.7",
		"turbo": "^2.10.5",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	}
}
