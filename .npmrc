# pnpm workspace config.
# - `auto-install-peers=true`: install peer deps automatically (matches
#   the default since pnpm 8 but pinned here for reproducibility).
# - `link-workspace-packages=true`: workspace:* deps resolve via symlink.
# - The `//registry.npmjs.org/:_authToken=${NPM_TOKEN}` line is consumed
#   by `npm publish` inside CI; locally it falls back to `npm login`
#   credentials from ~/.npmrc when NPM_TOKEN is unset.
auto-install-peers=true
link-workspace-packages=true
